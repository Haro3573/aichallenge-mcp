# Public deployment settings. Copy to your hosting provider's secret/config UI;
# never commit the populated file.
MCP_PRODUCTION=true
MCP_ALLOWED_HOSTS=mcp.example.com
MCP_STATELESS_HTTP=true
MCP_PORT=8000
LOG_LEVEL=info

# The deployed Kaggle source requires an operator-owned service credential.
# Store the value in the host's secret manager, not in this file or the image.
REQUIRE_KAGGLE_CREDENTIALS=true
KAGGLE_API_TOKEN=replace-with-secret-manager-reference
